DATABASE_PASSWORD=hangul-local
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Supabase settings for: npm run backend:supabase
# Copy the host, port, and username from Supabase Dashboard > Connect.
# Use the direct connection if your network supports IPv6; otherwise use Session pooler.
SUPABASE_JDBC_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=replace-with-your-supabase-database-password

AI_MODE=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
    
