JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Supabase PostgreSQL connection used by both local development and Docker Compose.
# Copy the Session pooler host and username from Supabase Dashboard > Connect.
SUPABASE_JDBC_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=replace-with-your-supabase-database-password

AI_MODE=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_GEMINI_FALLBACK_MODEL=gemini-3.6-flash
    
